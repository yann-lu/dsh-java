<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 从 0 重建练习仓库：与原工程 cn.xiaofuge:deepseek-harness-java 唯一的区别是坐标后缀 -zero，
         避免两个工程在 IDE / 本地仓库里互相混淆。模块名、依赖方向与原工程保持一致。 -->
    <groupId>cn.xiaofuge</groupId>
    <artifactId>deepseek-harness-java-zero</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>deepseek-harness-java-zero</name>
    <description>From-scratch rebuild practice of deepseek-harness-java. Skeleton only: signatures are copied, implementations are written from zero.</description>

    <!-- plugins/ 下两个模块（sample-tools-plugin、plugin-archetype）属于第 12 站内容，届时再加 -->
    <modules>
        <module>deepseek-harness-java-app</module>
        <module>deepseek-harness-java-trigger</module>
        <module>deepseek-harness-java-api</module>
        <module>deepseek-harness-java-case</module>
        <module>deepseek-harness-java-types</module>
        <module>deepseek-harness-java-domain</module>
        <module>deepseek-harness-java-infrastructure</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.2</spring-boot.version>
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <!-- 默认跳过单元测试（install/package 均生效），需要跑测试时用 -DskipTests=false -->
        <maven.test.skip>false</maven.test.skip>
        <skipTests>true</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 版本管理插件：统一升级/回退全工程（含子模块）版本号 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.16.2</version>
                <configuration>
                    <!-- 各模块版本与父工程保持一致 -->
                    <processAllModules>true</processAllModules>
                    <!-- 不产生 pom.xml.versionsBackup 备份文件 -->
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
